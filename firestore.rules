rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles: publicly readable (needed for anonymous feed),
    // but only the owner can create their own doc, and the permanent
    // anonymous identity + gender can never be changed after creation.
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.anonymousName == resource.data.anonymousName
                    && request.resource.data.gender == resource.data.gender;
      allow delete: if false;
    }

    // Global counter used to generate unique Kiubian-2026XXX identities.
    match /meta/kiubianCounter {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Posts: publicly readable (anonymous feed). Only the owner can
    // create, delete, or edit the caption. Reaction/comment/share
    // counters may be bumped by any signed-in user, but only one
    // counter field at a time, so nothing else can be tampered with.
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.authorUid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.authorUid == request.auth.uid;
      allow update: if request.auth != null && (
        (resource.data.authorUid == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption'])) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['loveCount']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hahaCount']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shareCount'])
      );

      match /reactions/{uid} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
                      && request.resource.data.authorUid == request.auth.uid;
        allow delete: if request.auth != null
                      && resource.data.authorUid == request.auth.uid;
        allow update: if false;
      }
    }
  }
}
